<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> | EduChain Passport</title>
  <!-- Bootstrap CDN for quick styling -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark mb-4" 
     style="background: linear-gradient(135deg, #1e3c72, #2a5298);">

  <div class="container">
    <a class="navbar-brand" href="/">EduChain Passport</a>
    <div class="collapse navbar-collapse">
      <ul class="navbar-nav ms-auto">

  <li class="nav-item">
    <a class="nav-link nav-btn" href="/wallet">Wallet</a>
  </li>

  <li class="nav-item">
    <a class="nav-link nav-btn" href="/issuer">Issuer</a>
  </li>

  <li class="nav-item">
    <a class="nav-link nav-btn" href="/verify">Verify</a>
  </li>

  <li class="nav-item">
    <a class="nav-link nav-btn" href="/zkproof">ZKP Demo</a>
  </li>

</ul>

<style>
  .nav-btn {
    background: #0d6efd;           /* Blue button */
    color: #fff !important;        /* White bold text */
    font-weight: 600;              /* Bold */
    padding: 8px 16px;
    border-radius: 8px;            /* Rounded corners */
    margin-left: 10px;
    transition: all 0.3s ease;
  }

  .nav-btn:hover {
    background: #084298;           /* Darker blue on hover */
    transform: translateY(-3px);   /* Lift animation */
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  /* Mobile Responsive */
  @media (max-width: 991px) {
    .nav-btn {
      display: block;
      margin: 8px 0;
    }
  }
</style>

