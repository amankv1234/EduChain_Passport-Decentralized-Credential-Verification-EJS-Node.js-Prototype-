<%- include('partials/header') %>

<!-- Header Section -->
<div class="py-4 mb-4 text-white shadow" style="background: linear-gradient(135deg, #1e3c72, #2a5298);">
  <div class="container">
    <h2 class="fw-bold mb-0"><i class="bi bi-shield-check"></i> Verify Credential</h2>
    <p class="mb-0 text-light">Check if a credential hash exists on the decentralized ledger</p>
  </div>
</div>

<div class="container mb-5">

  <!-- Verification Form Card -->
  <div class="card shadow-lg border-0 glass-card mb-4">
    <div class="card-body p-4">

      <h4 class="fw-bold mb-3 text-primary">
        <i class="bi bi-search"></i> Enter Credential Hash
      </h4>

      <form method="POST" action="/verify" class="row g-3">
        <div class="col-md-9">
          <input type="text" name="hash" class="form-control form-control-lg input-focus"
            placeholder="Paste credential hash here..." required>
        </div>

        <div class="col-md-3 d-grid">
          <button class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-check2-circle"></i> Verify
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- Results Section -->
  <% if (result) { %>
    
    <% if (result.error) { %>
      <div class="alert alert-warning shadow-sm fs-5">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= result.error %>
      </div>

    <% } else if (result.verified) { %>
      
      <!-- Verified Success Card -->
      <div class="card shadow-lg border-success border-3 verify-success-card">
        <div class="card-body p-4">

          <h3 class="text-success fw-bold mb-3">
            <i class="bi bi-patch-check-fill"></i> Credential Verified
          </h3>

          <p><strong>Student ID:</strong> <%= result.record.studentId %></p>
          <p><strong>Credential:</strong> <%= result.record.credential.title %></p>
          <p><strong>Issuer:</strong> <%= result.record.credential.issuer %></p>
          <p><strong>Issued On:</strong> <%= result.record.credential.issuedOn %></p>

          <hr>

          <p class="fw-bold mb-1">Blockchain Hash:</p>
          <div class="hash-box">
            <code><%= result.record.hash %></code>
          </div>

        </div>
      </div>

    <% } else { %>

      <!-- Not Verified -->
      <div class="alert alert-danger shadow-sm fs-5">
        <i class="bi bi-x-octagon-fill"></i> Credential Not Found — Hash does not match any record.
      </div>

    <% } %>

  <% } %>

</div>

<!-- Custom Styles -->
<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border-radius: 15px;
  }

  .verify-success-card {
    border-radius: 15px;
    transition: transform 0.3s ease;
  }

  .verify-success-card:hover {
    transform: translateY(-5px);
  }

  .input-focus:focus {
    border-color: #2a5298;
    box-shadow: 0 0 0 0.25rem rgba(30, 60, 114, 0.25);
  }

  .hash-box {
    background: #f1f3f5;
    padding: 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    word-break: break-all;
    border: 1px solid #ced4da;
  }
</style>

<%- include('partials/footer') %>
