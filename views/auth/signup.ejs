<%- include('../partials/header') %>

<!-- Header Section -->
<div class="py-4 mb-4 text-white shadow" style="background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);">
  <div class="container">
    <h2 class="fw-bold mb-0"><i class="bi bi-person-plus-fill"></i> Create Your Account</h2>
    <p class="mb-0 text-light">Join EduChain Passport to access your credentials securely</p>
  </div>
</div>

<div class="container mb-5">

  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-lg border-0 glass-card p-4">

        <h3 class="fw-bold text-center text-primary mb-3">Sign Up</h3>

        <!-- ERROR MESSAGE -->
        <% if (error) { %>
          <div class="alert alert-danger text-center"><%= error %></div>
        <% } %>

        <form method="POST" action="/auth/signup" class="row g-3">

          <div class="col-12">
            <label class="form-label fw-semibold">Full Name</label>
            <input type="text" name="name" class="form-control form-control-lg input-focus" required>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control form-control-lg input-focus" required>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Student ID</label>
            <input type="text" name="studentId" class="form-control form-control-lg input-focus" placeholder="Optional">
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" name="password" class="form-control form-control-lg input-focus" required>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Select Role</label>
            <select name="role" class="form-control form-control-lg input-focus">
              <option value="student">Student</option>
              <option value="issuer">Issuer</option>
              <option value="employer">Employer</option>
            </select>
          </div>

          <div class="col-12 mt-2 text-center">
            <button class="btn btn-primary btn-lg px-4 shadow"><i class="bi bi-arrow-right-circle"></i> Sign Up</button>
          </div>

          <p class="text-center mt-3">
            Already have an account?
            <a href="/auth/login" class="text-primary fw-semibold">Login here</a>
          </p>

        </form>
      </div>
    </div>
  </div>

</div>

<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border-radius: 15px;
  }
  .input-focus:focus {
    border-color: #2c5364;
    box-shadow: 0 0 0 0.25rem rgba(44, 83, 100, 0.25);
  }
</style>

<%- include('../partials/footer') %>
