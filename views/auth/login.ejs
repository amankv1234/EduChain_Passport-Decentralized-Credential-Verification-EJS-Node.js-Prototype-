<%- include('../partials/header') %>

<!-- Header Section -->
<div class="py-4 mb-4 text-white shadow" style="background: linear-gradient(135deg, #141e30, #243b55);">
  <div class="container">
    <h2 class="fw-bold mb-0"><i class="bi bi-box-arrow-in-right"></i> Login</h2>
    <p class="mb-0 text-light">Access your digital credential wallet securely</p>
  </div>
</div>

<div class="container mb-5">

  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-lg border-0 glass-card p-4">

        <h3 class="fw-bold text-center text-primary mb-3">Login</h3>

        <!-- SUCCESS MESSAGE -->
        <% if (success) { %>
          <div class="alert alert-success text-center"><%= success %></div>
        <% } %>

        <!-- ERROR MESSAGE -->
        <% if (error) { %>
          <div class="alert alert-danger text-center"><%= error %></div>
        <% } %>

        <form method="POST" action="/auth/login" class="row g-3">
          
          <div class="col-12">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control form-control-lg input-focus" required>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" name="password" class="form-control form-control-lg input-focus" required>
          </div>

          <div class="col-12 text-center mt-2">
            <button class="btn btn-primary btn-lg px-4 shadow"><i class="bi bi-box-arrow-in-right"></i> Login</button>
          </div>

          <p class="text-center mt-3">
            Don't have an account?
            <a href="/auth/signup" class="text-primary fw-semibold">Create one</a>
          </p>
        </form>

      </div>

    </div>
  </div>

</div>

<style>
  .glass-card {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(10px);
    border-radius: 15px;
  }
  .input-focus:focus {
    border-color: #243b55;
    box-shadow: 0 0 0 0.25rem rgba(36, 59, 85, 0.25);
  }
</style>

<%- include('../partials/footer') %>
